<!DOCTYPE html>
<html>
  <head>
    <title>Instagram</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  </head>

  <body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-light bg-light border-bottom mb-4">
      <div class="container d-flex justify-content-between align-items-center">
        <div class="logo">
          <a class="navbar-brand fw-bold" href="#">
            <i class="fa-brands fa-instagram fa-lg"></i> Instagram
          </a>
        </div>

        <div class="search-box">
            <%= form_with url: search_path, method: :get, local: true, class: 'form-inline search-form' do |form| %>
            <%= form.text_field :query, value: params[:query], class: 'form-control mr-sm-2', placeholder: '#search' %>
            <% end %>
        </div>

        
         <div class="user-section d-flex gap-3 align-items-center">
          <a href="#" class="text-dark"><i class="fa-regular fa-compass fa-lg"></i></a>
          <a href="#" class="text-dark"><i class="fa-regular fa-heart fa-lg"></i></a>

            <% if user_signed_in? %>
            <a href="<%= user_path(current_user) %>" class="text-dark">
              <i class="fa-regular fa-user fa-lg"></i>
            </a>
          <% else %>
            <a href="<%= new_user_session_path %>" class="btn btn-outline-primary btn-sm">Sign In</a>
          <% end %>
         
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="container" style="min-height: 500px;">
      <%= yield %>
    </main>

   <!-- Footer -->
    <footer class="container py-4 mt-5 text-center" style="max-width: 935px;">
      <div class="d-flex justify-content-center flex-wrap gap-3 mb-2" style="font-size: 12px; font-weight: 600;">
        <a href="#" class="text-decoration-none" style="color: #00376b;">ABOUT US</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">SUPPORT</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">PRESS</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">API</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">JOBS</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">PRIVACY</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">TERMS</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">DIRECTORY</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">PROFILES</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">HASHTAGS</a>
        <a href="#" class="text-decoration-none" style="color: #00376b;">LANGUAGE</a>
      </div>
      <p class="mb-0" style="font-size: 12px; color: #999; font-weight: 600;">© 2026 INSTAGRAM FROM META</p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>