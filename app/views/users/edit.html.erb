<style>
  .nav-pills .nav-link.active {
    background-color: transparent !important;
    color: #262626 !important;
    font-weight: 700 !important;
    border-left: 2px solid #262626 !important;
    border-radius: 0 !important;
  }
  .nav-pills .nav-link {
    color: #262626;
  }
  .nav-pills .nav-link:hover {
    background-color: #fafafa;
  }
</style>


<div class="container my-5" style="max-width: 935px;">
  <div class="card d-flex flex-row bg-white border" style="min-height: 540px; border-color: #dbdbdb !important; border-radius: 3px;">
    
    <!-- Left Navigation Menu (Pills/Tabs) -->
    <div style="width: 230px; border-right: 1px solid #dbdbdb;" class="py-2">
      <div class="nav flex-column nav-pills" id="settings-tab" role="tablist" aria-orientation="vertical">
        <button class="nav-link active text-start text-dark fw-bold py-3 ps-4 rounded-0" id="tab-edit-profile" data-bs-toggle="pill" data-bs-target="#content-edit-profile" type="button" role="tab" style="font-size: 14px; border-left: 2px solid #262626;">
          Edit Profile
        </button>
        <button class="nav-link text-start text-dark py-3 ps-4 rounded-0" id="tab-password" data-bs-toggle="pill" data-bs-target="#content-password" type="button" role="tab" style="font-size: 14px;">
          Change Password
        </button>
        <button class="nav-link text-start text-dark py-3 ps-4 rounded-0" id="tab-apps" data-bs-toggle="pill" data-bs-target="#content-apps" type="button" role="tab" style="font-size: 14px;">
          Apps and Websites
        </button>
        <button class="nav-link text-start text-dark py-3 ps-4 rounded-0" id="tab-email" data-bs-toggle="pill" data-bs-target="#content-email" type="button" role="tab" style="font-size: 14px;">
          Email and SMS
        </button>
        <button class="nav-link text-start text-dark py-3 ps-4 rounded-0" id="tab-push" data-bs-toggle="pill" data-bs-target="#content-push" type="button" role="tab" style="font-size: 14px;">
          Push Notifications
        </button>
        <button class="nav-link text-start text-dark py-3 ps-4 rounded-0" id="tab-contacts" data-bs-toggle="pill" data-bs-target="#content-contacts" type="button" role="tab" style="font-size: 14px;">
          Manage Contacts
        </button>
        <button class="nav-link text-start text-dark py-3 ps-4 rounded-0" id="tab-privacy" data-bs-toggle="pill" data-bs-target="#content-privacy" type="button" role="tab" style="font-size: 14px;">
          Privacy and Security
        </button>
      </div>
    </div>

    <!-- Right Side: Content Panes -->
    <div class="flex-grow-1 p-5 tab-content" id="settings-tabContent">
      
      <!-- 1. Edit Profile Tab (Actual Working Form) -->
      <div class="tab-pane fade show active" id="content-edit-profile" role="tabpanel">
        <div class="d-flex align-items-center gap-4 mb-4">
          <div style="width: 42px; height: 42px; border-radius: 50%; overflow: hidden;">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop&crop=face" 
                 alt="avatar" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div>
            <h5 class="mb-0 fw-normal" style="font-size: 16px;"><%= @user.username.presence || @user.email.split('@').first %></h5>
            <a href="#" class="text-decoration-none fw-semibold small text-primary">Change Profile Photo</a>
          </div>
        </div>

       <%= form_with model: (@user || current_user), local: true, html: {class: "form-horizontal form-edit-user"} do |f| %>
               
          <div class="form-group row">
            <%= f.label :avatar, class: 'col-sm-3 col-form-label' %>
            <div class="col-sm-9">
              <%= f.file_field :avatar, class: 'form-control' %>
            </div>
          </div>

          <div class="row mb-3 align-items-center">
            <label class="col-sm-3 text-sm-end fw-semibold small">Name</label>
            <div class="col-sm-9">
              <%= f.text_field :name, class: "form-control form-control-sm", placeholder: "Name" %>
              <div class="form-text text-muted" style="font-size: 11px;">
                Help people discover your account by using the name you're known by.
              </div>
            </div>
          </div>

          <div class="row mb-3 align-items-center">
            <label class="col-sm-3 text-sm-end fw-semibold small">Username</label>
            <div class="col-sm-9">
              <%= f.text_field :username, class: "form-control form-control-sm", placeholder: "Username" %>
            </div>
          </div>

          <div class="row mb-3 align-items-center">
            <label class="col-sm-3 text-sm-end fw-semibold small">Website</label>
            <div class="col-sm-9">
              <%= f.text_field :website, class: "form-control form-control-sm", placeholder: "Website" %>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-3 text-sm-end fw-semibold small pt-1">Bio</label>
            <div class="col-sm-9">
              <%= f.text_area :bio, rows: 3, class: "form-control form-control-sm", placeholder: "Bio" %>
            </div>
          </div>

          <div class="row mb-4 align-items-center">
            <label class="col-sm-3 text-sm-end fw-semibold small">Gender</label>
            <div class="col-sm-9">
              <%= f.select :gender, ["Not specified", "Male", "Female", "Prefer not to say"], {}, class: "form-select form-select-sm" %>
            </div>
          </div>

          <div class="row">
            <div class="col-sm-9 offset-sm-3">
              <%= f.submit "Submit", class: "btn btn-primary btn-sm px-4 fw-semibold", style: "background-color: #0095f6; border: none;" %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- 2. Change Password Tab -->
      <div class="tab-pane fade" id="content-password" role="tabpanel">
        <h5 class="fw-normal mb-4">Change Password</h5>
        <div class="mb-3" style="max-width: 400px;">
          <label class="form-label small fw-semibold">Old Password</label>
          <input type="password" class="form-control form-control-sm">
        </div>
        <div class="mb-3" style="max-width: 400px;">
          <label class="form-label small fw-semibold">New Password</label>
          <input type="password" class="form-control form-control-sm">
        </div>
        <button class="btn btn-primary btn-sm px-3 mt-2">Change Password</button>
      </div>

      <!-- 3. Other Tabs -->
      <div class="tab-pane fade text-muted" id="content-apps" role="tabpanel">
        <h5>Apps and Websites</h5>
        <p class="small">No active applications connected.</p>
      </div>
      <div class="tab-pane fade text-muted" id="content-email" role="tabpanel">
        <h5>Email and SMS</h5>
        <p class="small">Notification preferences settings.</p>
      </div>
      <div class="tab-pane fade text-muted" id="content-push" role="tabpanel">
        <h5>Push Notifications</h5>
        <p class="small">Manage mobile and browser notifications.</p>
      </div>
      <div class="tab-pane fade text-muted" id="content-contacts" role="tabpanel">
        <h5>Manage Contacts</h5>
        <p class="small">Contacts sync options.</p>
      </div>
      <div class="tab-pane fade text-muted" id="content-privacy" role="tabpanel">
        <h5>Privacy and Security</h5>
        <p class="small">Account privacy and data settings.</p>
      </div>

    </div>

  </div>
</div>