<div class="container mt-4 mb-5" style="max-width: 600px;">
  <div class="card p-4 shadow-sm border">
    <h3 class="fw-normal mb-4 text-center">Edit Profile</h3>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :username, class: "form-label fw-semibold small" %>
        <%= f.text_field :username, class: "form-control form-control-sm", autofocus: true %>
      </div>

      <div class="mb-3">
        <%= f.label :name, class: "form-label fw-semibold small" %>
        <%= f.text_field :name, class: "form-control form-control-sm" %>
      </div>

      <div class="mb-3">
        <%= f.label :website, class: "form-label fw-semibold small" %>
        <%= f.url_field :website, class: "form-control form-control-sm", placeholder: "https://example.com" %>
      </div>

      <div class="mb-3">
        <%= f.label :bio, class: "form-label fw-semibold small" %>
        <%= f.text_area :bio, rows: 3, class: "form-control form-control-sm" %>
      </div>

      <div class="mb-3">
        <%= f.label :email, class: "form-label fw-semibold small" %>
        <%= f.email_field :email, class: "form-control form-control-sm", autocomplete: "email" %>
      </div>

      <hr class="my-4">

      <div class="mb-3">
        <%= f.label :password, "New Password (leave blank if you don't want to change it)", class: "form-label text-muted small" %>
        <%= f.password_field :password, class: "form-control form-control-sm", autocomplete: "new-password" %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Confirm New Password", class: "form-label text-muted small" %>
        <%= f.password_field :password_confirmation, class: "form-control form-control-sm", autocomplete: "new-password" %>
      </div>

      <div class="mb-4">
        <%= f.label :current_password, "Current Password (required to confirm changes)", class: "form-label fw-semibold small text-danger" %>
        <%= f.password_field :current_password, class: "form-control form-control-sm", autocomplete: "current-password" %>
      </div>

      <div class="d-grid gap-2">
        <%= f.submit "Submit", class: "btn btn-primary btn-sm fw-semibold" %>
      </div>
    <% end %>
  </div>
</div>